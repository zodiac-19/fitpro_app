rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // Profile: owner writes/deletes; a linked friend can read.
    match /users/{uid} {
      allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/connections/$(pairId(request.auth.uid, uid)))
      );
    }

    // Invite code -> uid lookup. No listing; only get by exact code.
    match /codes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Link between two users. Only members can create, read, update or delete.
    match /connections/{id} {
      allow create: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && id == pairId(request.resource.data.members[0], request.resource.data.members[1]);
      allow update: if request.auth != null
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow read, delete: if request.auth != null
        && request.auth.uid in resource.data.members;
    }
  }
}
