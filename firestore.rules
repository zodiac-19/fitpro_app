rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    // A user's public profile: the owner writes it; a linked friend can read it.
    match /users/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        exists(/databases/$(database)/documents/connections/$(pairId(request.auth.uid, uid)))
      );
    }

    // Invite code -> uid lookup.
    match /codes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // A link between two users. Only members can create, read or delete it.
    match /connections/{id} {
      allow create, update: if request.auth != null
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && id == pairId(request.resource.data.members[0], request.resource.data.members[1]);
      allow read, delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
  }
}
