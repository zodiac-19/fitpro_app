{
  "expo": {
    "name": "Fitpro",
    "slug": "fitpro",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/1133e458-6299-4b50-8b66-a7f825327eff"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090A12"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zodiac.fitpro"
    },
    "android": {
      "package": "com.zodiac.fitpro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090A12"
      },
      "versionCode": 1,
      "permissions": [
        "CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "1133e458-6299-4b50-8b66-a7f825327eff"
      }
    },
    "scheme": "fitpro",
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3143960924694698~1851533544",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fitpro needs your photos to analyze your physique and verify progress.",
          "cameraPermission": "Fitpro needs the camera to scan your physique and verify progress."
        }
      ]
    ]
  }
}
